{#-
  One Crop Sown activity as a DCI registry record.

  The activity reaching this template is already filtered to the partner's
  consented data scopes (meta_data/data-scopes/: activity, crop_season,
  measures, farmer_reference, location — named groups of CropSown.activity.*
  fields, independent of this layout): a field outside them is null. The
  groups below happen to mirror those scopes, but a scope is defined by its
  fields, not by a key of this record.

  measures.details is the stage's payload without the keys that belong to
  other scopes (farmer, development agent, location): the payload repeats
  them, and measures must not carry them.
-#}
{%- set a = expanded -%}
{%- set not_details = ["farmer_id", "fayda_fan", "da_id", "latitude", "longitude", "geo_lowest_level_value_id"] -%}
{%- set payload = a.get("payload") -%}
{
  "@type": "spdci-extensions-agri:CropActivity",
  "activity": {
    "activity_id": {{ a.get("activity_id") | tojson }},
    "activity_type": {{ a.get("activity_type") | tojson }},
    "occurred_at": {{ a.get("occurred_at") | tojson }},
    "occurred_on_ec": {{ a.get("occurred_on_ec") | tojson }},
    "recorded_at": {{ a.get("recorded_at") | tojson }},
    "channel": {{ a.get("channel") | tojson }},
    "verification_status": {{ a.get("verification_status") | tojson }}
  },
  "crop_season": {
    "plot_id": {{ a.get("plot_id") | tojson }},
    "crop_year": {{ a.get("crop_year") | tojson }},
    "season": {{ a.get("season") | tojson }},
    "crop": {{ a.get("crop") | tojson }},
    "variety": {{ a.get("variety") | tojson }},
    "cluster_id": {{ a.get("cluster_id") | tojson }}
  },
  "measures": {
    "area_ha": {{ a.get("area_ha") | tojson }},
    "quantity_qt": {{ a.get("quantity_qt") | tojson }},
    "details": {{ (dict(payload | dictsort | rejectattr(0, "in", not_details)) if payload is mapping else none) | tojson }}
  },
  "farmer_reference": {
    "farmer_id": {{ a.get("farmer_id") | tojson }},
    "fayda_fan": {{ a.get("fayda_fan") | tojson }}
  },
  "location": {
    "latitude": {{ a.get("latitude") | tojson }},
    "longitude": {{ a.get("longitude") | tojson }},
    "geo_lowest_level_value_id": {{ a.get("geo_lowest_level_value_id") | tojson }},
    "levels": {{ a.get("geo_dimensions") | tojson }}
  }
}
